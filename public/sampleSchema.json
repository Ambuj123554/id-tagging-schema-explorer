  "fields": {
    "name": {
      "key": "name",
      "type": "text",
      "label": "Name",
      "placeholder": "Common name",
      "universal": true
    },
    "cuisine": {
      "key": "cuisine",
      "type": "combo",
      "label": "Cuisine",
      "strings": {
        "options": {
          "pizza": "Pizza",
          "burger": "Burger",
          "chinese": "Chinese",
          "italian": "Italian",
          "mexican": "Mexican",
          "indian": "Indian",
          "japanese": "Japanese",
          "thai": "Thai",
          "vietnamese": "Vietnamese"
        }
      }
    },
    "phone": {
      "key": "phone",
      "type": "tel",
      "label": "Phone",
      "placeholder": "+1-234-567-8900",
      "universal": true
    },
    "website": {
      "key": "website",
      "type": "url",
      "label": "Website",
      "placeholder": "https://example.com",
      "universal": true
    },
    "email": {
      "key": "email",
      "type": "email",
      "label": "Email",
      "placeholder": "example@example.com"
    },
    "address": {
      "type": "address",
      "label": "Address",
      "keys": ["addr:housenumber", "addr:street", "addr:city", "addr:postcode"]
    },
    "opening_hours": {
      "key": "opening_hours",
      "type": "text",
      "label": "Opening Hours",
      "placeholder": "Mo-Fr 09:00-17:00"
    },
    "outdoor_seating": {
      "key": "outdoor_seating",
      "type": "check",
      "label": "Outdoor Seating"
    },
    "delivery": {
      "key": "delivery",
      "type": "check",
      "label": "Delivery"
    },
    "takeaway": {
      "key": "takeaway",
      "type": "check",
      "label": "Takeaway"
    },
    "smoking": {
      "key": "smoking",
      "type": "radio",
      "label": "Smoking",
      "strings": {
        "options": {
          "yes": "Allowed",
          "no": "Not allowed",
          "outside": "Outside only"
        }
      }
    },
    "internet_access": {
      "key": "internet_access",
      "type": "combo",
      "label": "Internet Access",
      "strings": {
        "options": {
          "yes": "Yes",
          "no": "No",
          "wlan": "WiFi",
          "wired": "Wired"
        }
      }
    },
    "operator": {
      "key": "operator",
      "type": "text",
      "label": "Operator"
    },
    "capacity": {
      "key": "capacity",
      "type": "number",
      "label": "Capacity",
      "placeholder": "50"
    },
    "fee": {
      "key": "fee",
      "type": "radio",
      "label": "Fee",
      "strings": {
        "options": {
          "yes": "Yes",
          "no": "No"
        }
      }
    },
    "surface": {
      "key": "surface",
      "type": "combo",
      "label": "Surface",
      "strings": {
        "options": {
          "paved": "Paved",
          "unpaved": "Unpaved",
          "asphalt": "Asphalt",
          "concrete": "Concrete",
          "grass": "Grass",
          "gravel": "Gravel"
        }
      }
    },
    "access_simple": {
      "key": "access",
      "type": "radio",
      "label": "Access",
      "strings": {
        "options": {
          "yes": "Public",
          "private": "Private",
          "permissive": "Permissive"
        }
      }
    },
    "shop": {
      "key": "shop",
      "type": "text",
      "label": "Shop Type"
    },
    "network": {
      "key": "network",
      "type": "text",
      "label": "Network"
    },
    "ref": {
      "key": "ref",
      "type": "text",
      "label": "Reference"
    },
    "shelter": {
      "key": "shelter",
      "type": "check",
      "label": "Shelter"
    },
    "bench": {
      "key": "bench",
      "type": "check",
      "label": "Bench"
    },
    "parking": {
      "key": "parking",
      "type": "combo",
      "label": "Type",
      "strings": {
        "options": {
          "surface": "Surface",
          "multi-storey": "Multi-storey",
          "underground": "Underground"
        }
      }
    },
    "supervised": {
      "key": "supervised",
      "type": "check",
      "label": "Supervised"
    },
    "emergency": {
      "key": "emergency",
      "type": "check",
      "label": "Emergency Services"
    },
    "beds": {
      "key": "beds",
      "type": "number",
      "label": "Beds"
    },
    "grades": {
      "key": "grades",
      "type": "text",
      "label": "Grades"
    },
    "dog": {
      "key": "dog",
      "type": "radio",
      "label": "Dogs",
      "strings": {
        "options": {
          "yes": "Allowed",
          "no": "Not allowed",
          "leashed": "On leash"
        }
      }
    },
    "min_age": {
      "key": "min_age",
      "type": "number",
      "label": "Minimum Age"
    },
    "max_age": {
      "key": "max_age",
      "type": "number",
      "label": "Maximum Age"
    },
    "lit": {
      "key": "lit",
      "type": "check",
      "label": "Lit"
    },
    "description": {
      "key": "description",
